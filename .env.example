# Copy to `.env` and fill in. Loaded automatically by src/kms/core/llm.py.
# Three keys are required for a full pipeline run:
#   MISTRAL_API_KEY    — page OCR (markdown + figure extraction), the front-end
#   OPENROUTER_API_KEY — the correction pass (Qwen3-VL proofreads each page vs its image)
#   DEEPSEEK_API_KEY   — text nodes (extractor, seam, splitter, finders, attributors, distributor)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=sk-or-
DEEPSEEK_API_KEY=sk-

# Optional model overrides (defaults shown):
# TEXT_MODEL=deepseek/deepseek-v4-flash
# CORRECTOR_MODEL=openrouter/qwen/qwen3-vl-235b-a22b-instruct
# CORRECTOR_PROVIDER=DeepInfra

# --- Graph tier (Neo4j) ---
# The durable graph the graph tier reads and writes. Same four values whether you point at
# Aura (neo4j+s://…) or a self-hosted instance (bolt://…).
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=...
# NEO4J_DATABASE=neo4j
#
# Transport: `auto` (default) tries Bolt (TCP 7687) and falls back to the HTTP
# Query API when the port is blocked — which is what sandboxes that only allow
# egress on 443 (CI, Claude Code web sessions) need. Force one with `bolt` or
# `http`; `http` also skips the ~5s Bolt probe.
# NEO4J_TRANSPORT=auto
# NEO4J_BOLT_PROBE_TIMEOUT=5
#
# The HTTP base URL is derived from NEO4J_URI (Aura -> https://<host>,
# self-hosted -> :7474/:7473). Set this only for a reverse proxy or an odd port.
# NEO4J_HTTP_URL=https://xxxx.databases.neo4j.io
# NEO4J_HTTP_TIMEOUT=60
